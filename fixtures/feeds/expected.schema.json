{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paiya.invalid/contracts/feed-expectations.schema.json",
  "title": "Paiya synthetic feed expectations",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "runs"],
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "group_key": { "type": "string", "pattern": "^synthetic-[A-Za-z0-9._-]{1,190}$" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expect"],
      "properties": {
        "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "stop_reason",
            "partial_reasons",
            "cards_seen",
            "cards_parsed",
            "checkpoint_advanced",
            "labelled_visible_keys",
            "ingested_keys"
          ],
          "properties": {
            "coverage": { "enum": ["complete", "partial", "none"] },
            "stop_reason": {
              "enum": [
                "overlap_reached",
                "feed_end",
                "time_budget_exhausted",
                "scroll_budget_exhausted",
                "access_blocked"
              ]
            },
            "partial_reasons": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["sort_unverified", "budget_before_overlap", "feed_stopped_before_overlap", "parse_failures"] }
            },
            "cards_seen": { "type": "integer", "minimum": 0 },
            "cards_parsed": { "type": "integer", "minimum": 0 },
            "checkpoint_advanced": { "type": "boolean" },
            "labelled_visible_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "ingested_keys": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
